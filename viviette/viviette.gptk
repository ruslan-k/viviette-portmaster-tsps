# Viviette gptokeyb config for TSP / SpruceOS
# GameMaker keyboard defaults: Z confirm, X cancel/back, arrows move.

deadzone_mode = scaled_radial
deadzone = 2000
repeat_delay = 32
repeat_interval = 1

# Face buttons
a = z
b = x
x = a
y = s

# Start / Select
start = enter
select = escape

# D-pad
up = up
down = down
left = left
right = right

# Left analog mirrors D-pad
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

# Right analog spare keys
right_analog_up = i
right_analog_down = k
right_analog_left = j
right_analog_right = l

# Shoulder buttons
l1 = pageup
r1 = pagedown
